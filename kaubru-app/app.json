{
  "expo": {
    "name": "KauBru Translator",
    "slug": "kaubru-app",
    "scheme": "kaubru-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kaubru.translator"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A1A"
      },
      "package": "com.kaubru.translator",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow KauBru Translator to access your microphone to record pronunciations."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c68c6b42-923e-4b22-beb7-3707b02100c6"
      }
    },
    "owner": "isaac09864",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c68c6b42-923e-4b22-beb7-3707b02100c6"
    }
  }
}
